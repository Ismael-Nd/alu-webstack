#!/usr/bin/env bash
# Report the DNS record type and destination of one or four subdomains.
show_record() {
    local domain="$1"
    local subdomain="$2"
    dig +noall +answer "$subdomain.$domain" |
        awk -v name="$subdomain" 'NR == 1 { print "The subdomain " name " is a " $4 " record and points to " $5; exit }'
}

if [ "$#" -eq 2 ]; then
    show_record "$1" "$2"
else
    for subdomain in www lb-01 web-01 web-02; do
        show_record "$1" "$subdomain"
    done
fi
